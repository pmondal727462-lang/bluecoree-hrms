DATABASE_URL="postgresql://hrms:CHANGE_ME@localhost:5432/hrms?schema=public"
# Runtime roles (npm run db:roles). The app role is subject to row-level
# security; the system role bypasses it for sign-in, platform administration
# and jobs. DATABASE_URL is the migration owner. Both are required in production.
APP_DATABASE_URL="postgresql://hrms_app:CHANGE_ME_LONG_PASSWORD@localhost:5432/hrms?schema=public"
SYSTEM_DATABASE_URL="postgresql://hrms_system:CHANGE_ME_LONG_PASSWORD@localhost:5432/hrms?schema=public"
JWT_SECRET="generate-with-npm-run-env-init"
JWT_REFRESH_SECRET="generate-with-npm-run-env-init"
ENCRYPTION_KEY="generate-with-npm-run-env-init"
SETUP_TOKEN="generate-with-npm-run-env-init"
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
TRUST_PROXY="false"
# S3-compatible private file storage (AWS S3, Cloudflare R2). Leave empty to
# use local storage in data/uploads. Set before building so the storage origin
# is allowed for inline images.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Phase A: optional AI. Configure a chat-completions compatible model.
# AI remains disabled per company until an administrator enables it.
AI_PROVIDER="compatible"
AI_BASE_URL=""
AI_MODEL=""
AI_API_KEY=""

# Face adapter service; production liveness integration is required before enabling.
FACE_PROVIDER_URL=""
FACE_PROVIDER_KEY=""

# Backups: a separate 32-byte hex key. Store a copy outside this server;
# encrypted backups cannot be restored without it.
BACKUP_ENCRYPTION_KEY="generate-with-npm-run-env-init"
BACKUP_DIR="data/backups"
PG_BIN_DIR=""
BACKUP_DAILY_AT="02:00"
BACKUP_WEEKLY_DAY="0"
BACKUP_DAILY_RETENTION_DAYS="7"
BACKUP_WEEKLY_RETENTION_DAYS="35"

# Mobile push notifications (optional). Expo push tokens from the Expo app:
EXPO_PUSH_ENABLED=
EXPO_ACCESS_TOKEN=
# Native FCM tokens (Firebase service account; the key may use \n escapes):
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# SMS (optional): SMS_PROVIDER=twilio with TWILIO_* and SMS_FROM, or msg91 with MSG91_*.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER=
MSG91_ROUTE=
# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Billing: with RAZORPAY_KEY_ID/SECRET above, set the webhook secret too.
# Without Razorpay, invoices are paid offline and confirmed by the Super Admin.
RAZORPAY_WEBHOOK_SECRET=
# Supplier details printed on GST tax invoices.
BILLING_SUPPLIER_NAME=
BILLING_SUPPLIER_GSTIN=
BILLING_SUPPLIER_STATE=
BILLING_SUPPLIER_ADDRESS=
# Where contact-form enquiries are emailed.
SALES_EMAIL=

# Background worker (npm run worker). Without REDIS_URL it schedules in-process.
REDIS_URL=
WORKER_CONCURRENCY=2
