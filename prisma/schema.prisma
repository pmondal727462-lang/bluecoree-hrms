generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  workJobs                  WorkJob[]
  workAssignments           WorkAssignment[]
  workLogs                  WorkLog[]
  agencies                  WorkAgency[]
  workerContracts           WorkerContract[]
  attendanceBreaks          AttendanceBreak[]
  celebrationWishes         CelebrationWish[]
  id                        String                     @id @default(cuid())
  code                      String                     @unique
  name                      String
  email                     String
  phone                     String?
  website                   String?
  address                   String?
  gstin                     String?
  pan                       String?
  tan                       String?
  cin                       String?
  pfRegistration            String?
  esiRegistration           String?
  timezone                  String                     @default("Asia/Kolkata")
  workingDays               Int[]                      @default([1, 2, 3, 4, 5])
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  users                     User[]
  roles                     Role[]
  departments               Department[]
  designations              Designation[]
  branches                  Branch[]
  employees                 Employee[]
  auditLogs                 AuditLog[]
  attendancePolicy          AttendancePolicy?
  fieldTrackingSessions     FieldTrackingSession[]
  fieldTrackingPoints       FieldTrackingPoint[]
  payslips                  Payslip[]
  devices                   EmployeeDevice[]
  pushTokens                PushToken[]
  faceProfiles              FaceProfile[]
  faceVerificationLogs      FaceVerificationLog[]
  attendance                Attendance[]
  shifts                    Shift[]
  holidays                  Holiday[]
  leaveTypes                LeaveType[]
  leaveRequests             LeaveRequest[]
  attendanceRegularizations AttendanceRegularization[]
  attendanceLocations       AttendanceLocation[]
  geofenceEvents            GeofenceEvent[]
  integrations              Integration[]
  integrationLogs           IntegrationLog[]
  webhooks                  Webhook[]
  apiKeys                   ApiKey[]
  apiLogs                   ApiLog[]
  mfaSetting                MfaSetting?
  loginHistory              LoginHistory[]
  securityEvents            SecurityEvent[]
  subscription              Subscription?
  subscriptionUsage         SubscriptionUsage[]
  branding                  CompanyBranding?
  supportTickets            SupportTicket[]
  statutorySetting          StatutorySetting?
  payrollRuns               PayrollRun[]
  expenseCategories         ExpenseCategory[]
  jobOpenings               JobOpening[]
  reviewCycles              ReviewCycle[]
  reportDefinitions         ReportDefinition[]
  aiSettings                AiSettings?
  aiConversations           AiConversation[]
  aiAccessLogs              AiAccessLog[]
  aiDocuments               AiGeneratedDocument[]
  status                    String                     @default("ACTIVE")
  suspendedAt               DateTime?
  suspendReason             String?
  settings                  CompanySetting?
  documents                 Document[]
  onboardingTemplates       OnboardingTaskTemplate[]
  onboardings               Onboarding[]
  announcements             Announcement[]
  notificationTemplates     NotificationTemplate[]
  attendancePunches         AttendancePunch[]
  rosterEntries             RosterEntry[]
  leaveLedger               LeaveLedger[]
  compOffRequests           CompOffRequest[]
  holidaySelections         HolidaySelection[]
  employeeAddresses         EmployeeAddress[]
  employeeEmergencyContacts EmployeeEmergencyContact[]
  employeeBankAccounts      EmployeeBankAccount[]
  attendanceDevices         AttendanceDevice[]
  deviceUserMappings        DeviceUserMapping[]
  devicePunches             DevicePunch[]
  deviceSyncLogs            DeviceSyncLog[]
  statutoryRules            StatutoryRule[]
  employeeLoans             EmployeeLoan[]
  loanRepayments            LoanRepayment[]
  careersEnabled            Boolean                    @default(false)
  careersIntro              String?
  offers                    Offer[]
  peerReviews               PeerReview[]
  courses                   Course[]
  trainers                  Trainer[]
  trainingSessions          TrainingSession[]
  trainingEnrollments       TrainingEnrollment[]
  employeeSkills            EmployeeSkill[]
  assets                    Asset[]
  assetAssignments          AssetAssignment[]
  billingState              String?
  billingEmail              String?
  onboardingDismissedAt     DateTime?
  subscriptionAddOns        SubscriptionAddOn[]
  invoices                  Invoice[]
  payments                  Payment[]
  refunds                   Refund[]
  legalHold                 Boolean                    @default(false)
  retentionPolicies         RetentionPolicy[]
  retentionRuns             RetentionRun[]

  @@map("companies")
}

model Permission {
  key         String           @id
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  system      Boolean          @default(false)
  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("roles")
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model User {
  celebrationWishes  CelebrationWish[]
  id                 String                @id @default(cuid())
  companyId          String
  roleId             String
  name               String
  email              String
  mobile             String?
  passwordHash       String
  mustSetPassword    Boolean               @default(false)
  passwordSetAt      DateTime?
  twoFactorSecret    String?
  twoFactorEnabled   Boolean               @default(false)
  lastTotpStep       BigInt?
  failedLoginCount   Int                   @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime              @default(now())
  mustChangePassword Boolean               @default(false)
  recoveryCodeHashes String[]              @default([])
  active             Boolean               @default(true)
  isSuperAdmin       Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  company            Company               @relation(fields: [companyId], references: [id])
  role               Role                  @relation(fields: [roleId, companyId], references: [id, companyId])
  employee           Employee?
  sessions           Session[]
  aiConversations    AiConversation[]
  aiAccessLogs       AiAccessLog[]
  aiDocuments        AiGeneratedDocument[]
  devices            EmployeeDevice[]
  pushTokens         PushToken[]
  mobileSessions     MobileSession[]
  loginHistory       LoginHistory[]
  lastLoginAt        DateTime?
  notifications      Notification[]
  interviews         Interview[]

  @@unique([companyId, email])
  @@unique([companyId, mobile])
  @@unique([id, companyId])
  @@map("users")
}

model AiSettings {
  companyId               String  @id
  enabled                 Boolean @default(false)
  allowExternalProcessing Boolean @default(false)
  retentionDays           Int     @default(30)
  company                 Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

model AiConversation {
  id                String      @id @default(cuid())
  companyId         String
  userId            String
  accessFingerprint String
  createdAt         DateTime    @default(now())
  expiresAt         DateTime
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  messages          AiMessage[]

  @@unique([id, companyId])
  @@index([companyId, userId, createdAt])
  @@map("ai_conversations")
}

model AiMessage {
  id               String         @id @default(cuid())
  conversationId   String
  role             String
  contentEncrypted String
  createdAt        DateTime       @default(now())
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiAccessLog {
  id              String   @id @default(cuid())
  companyId       String
  userId          String
  query           String
  intent          String
  dataSources     String[]
  timestamp       DateTime @default(now())
  responseSummary String
  status          String
  expiresAt       DateTime
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, timestamp])
  @@map("ai_access_logs")
}

model AiGeneratedDocument {
  id               String    @id @default(cuid())
  companyId        String
  userId           String
  kind             String
  title            String
  contentEncrypted String
  inputEncrypted   String
  status           String    @default("Draft")
  revision         Int       @default(1)
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, kind, status])
  @@map("ai_generated_documents")
}

model Session {
  id            String         @id @default(cuid())
  userId        String
  refreshHash   String
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  lastUsedAt    DateTime       @default(now())
  ip            String?
  userAgent     String?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobileSession MobileSession?

  @@index([userId])
  @@map("sessions")
}

model Department {
  id            String         @id @default(cuid())
  companyId     String
  name          String
  company       Company        @relation(fields: [companyId], references: [id])
  employees     Employee[]
  jobOpenings   JobOpening[]
  onboardings   Onboarding[]
  announcements Announcement[]
  offers        Offer[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("departments")
}

model Designation {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  company     Company      @relation(fields: [companyId], references: [id])
  employees   Employee[]
  onboardings Onboarding[]
  offers      Offer[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("designations")
}

model Branch {
  workJobs        WorkJob[]
  id              String         @id @default(cuid())
  companyId       String
  name            String
  address         String?
  geofenceEnabled Boolean        @default(false)
  latitude        Float?
  longitude       Float?
  radiusMeters    Int            @default(200)
  company         Company        @relation(fields: [companyId], references: [id])
  employees       Employee[]
  announcements   Announcement[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("branches")
}

model Employee {
  workAssignments           WorkAssignment[]
  workLogs                  WorkLog[]
  workerContracts           WorkerContract[]
  attendanceBreaks          AttendanceBreak[]
  celebrationWishes         CelebrationWish[]
  id                        String                     @id @default(cuid())
  companyId                 String
  userId                    String?                    @unique
  employeeCode              String
  firstName                 String
  middleName                String?
  lastName                  String
  officialEmail             String
  personalEmail             String?
  mobile                    String?
  gender                    String?
  dateOfBirth               DateTime?                  @db.Date
  bloodGroup                String?
  maritalStatus             String?
  joinedAt                  DateTime                   @db.Date
  confirmationDate          DateTime?                  @db.Date
  employmentType            String                     @default("Full time")
  status                    String                     @default("Active")
  attendanceMode            String                     @default("DEFAULT")
  fieldTrackingAllowed      Boolean                    @default(false)
  faceRequired              Boolean                    @default(false)
  probationDays             Int                        @default(90)
  noticeDays                Int                        @default(30)
  departmentId              String?
  designationId             String?
  branchId                  String?
  managerId                 String?
  sensitiveEncrypted        String?
  photoKey                  String?
  photoType                 String?
  photoSize                 Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  company                   Company                    @relation(fields: [companyId], references: [id])
  user                      User?                      @relation(fields: [userId, companyId], references: [id, companyId])
  department                Department?                @relation(fields: [departmentId, companyId], references: [id, companyId])
  designation               Designation?               @relation(fields: [designationId, companyId], references: [id, companyId])
  branch                    Branch?                    @relation(fields: [branchId, companyId], references: [id, companyId])
  manager                   Employee?                  @relation("Reporting", fields: [managerId, companyId], references: [id, companyId])
  reports                   Employee[]                 @relation("Reporting")
  shiftId                   String?
  shift                     Shift?                     @relation(fields: [shiftId, companyId], references: [id, companyId])
  attendance                Attendance[]
  leaveRequests             LeaveRequest[]
  attendanceRegularizations AttendanceRegularization[]
  salaryStructure           SalaryStructure?
  payrollItems              PayrollRunItem[]
  expenseClaims             ExpenseClaim[]
  goals                     Goal[]
  performanceReviews        PerformanceReview[]        @relation("ReviewEmployee")
  feedbackReceived          Feedback[]
  attendanceLocations       EmployeeLocation[]
  geofenceEvents            GeofenceEvent[]
  fieldTrackingSessions     FieldTrackingSession[]
  fieldTrackingPoints       FieldTrackingPoint[]
  faceProfile               FaceProfile?
  faceVerificationLogs      FaceVerificationLog[]
  payslips                  Payslip[]
  history                   EmployeeHistory[]
  exitSettlement            ExitSettlement?
  documents                 Document[]
  documentAcknowledgements  DocumentAcknowledgement[]
  helpdeskTickets           HelpdeskTicket[]
  punches                   AttendancePunch[]
  rosterEntries             RosterEntry[]
  leaveLedger               LeaveLedger[]
  compOffRequests           CompOffRequest[]
  holidaySelections         HolidaySelection[]
  managedJobOpenings        JobOpening[]               @relation("JobHiringManager")
  hiredCandidates           Candidate[]                @relation("CandidateHiredEmployee")
  reviewsToGive             PerformanceReview[]        @relation("ReviewReviewer")
  onboardings               Onboarding[]               @relation("OnboardingEmployee")
  addresses                 EmployeeAddress[]
  emergencyContacts         EmployeeEmergencyContact[]
  bankAccounts              EmployeeBankAccount[]
  deviceUserMappings        DeviceUserMapping[]
  devicePunches             DevicePunch[]
  loans                     EmployeeLoan[]
  peerReviewsGiven          PeerReview[]               @relation("PeerReviewer")
  trainerProfile            Trainer?                   @relation("TrainerEmployee")
  trainingEnrollments       TrainingEnrollment[]
  skills                    EmployeeSkill[]
  assetAssignments          AssetAssignment[]

  @@unique([companyId, employeeCode])
  @@unique([userId, companyId])
  @@unique([companyId, officialEmail])
  @@unique([id, companyId])
  @@index([companyId, status, departmentId])
  @@map("employees")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  actorId   String?
  actorName String
  action    String
  module    String
  recordId  String?
  ip        String?
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

model SetupState {
  id          Int      @id
  completedAt DateTime @default(now())

  @@map("setup_state")
}

model AuthChallenge {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, userId, kind])
  @@map("auth_challenges")
}

model AttendancePolicy {
  singlePunchStatus            String  @default("MISSED_PUNCH")
  companyId                    String  @id
  gpsTrackingEnabled           Boolean @default(false)
  fieldTrackingEnabled         Boolean @default(false)
  fieldTrackingIntervalSeconds Int     @default(30)
  fieldTrackingMaxMinutes      Int     @default(720)
  faceAttendanceEnabled        Boolean @default(false)
  faceLivenessRequired         Boolean @default(true)
  faceConfidenceThreshold      Float   @default(0.8)
  faceMaxFailedAttempts        Int     @default(5)
  faceLockoutMinutes           Int     @default(15)
  faceFallback                 String  @default("NONE")
  geofenceEnabled              Boolean @default(false)
  latitude                     Float?
  longitude                    Float?
  radiusMeters                 Int     @default(200)
  company                      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  multiplePunchesAllowed       Boolean @default(false)
  overtimeRequiresApproval     Boolean @default(true)
  compOffEnabled               Boolean @default(false)
  compOffExpiryDays            Int     @default(90)
  optionalHolidayLimit         Int     @default(2)

  @@map("attendance_policies")
}

model FaceProfile {
  id                 String   @id @default(cuid())
  companyId          String
  employeeId         String   @unique
  templateCiphertext String
  enrolledAt         DateTime @default(now())
  active             Boolean  @default(true)
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee           Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([employeeId, companyId])
  @@index([companyId, employeeId, active])
  @@map("face_profiles")
}

model FaceVerificationLog {
  id             String      @id @default(cuid())
  companyId      String
  employeeId     String
  attendanceId   String?
  status         String
  confidence     Float?
  livenessPassed Boolean     @default(false)
  reason         String?
  deviceId       String?
  ip             String?
  sampleHash     String?
  createdAt      DateTime    @default(now())
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee    @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  attendance     Attendance? @relation(fields: [attendanceId, companyId], references: [id, companyId], onDelete: NoAction)

  @@index([companyId, employeeId, createdAt])
  @@index([employeeId, sampleHash])
  @@map("face_verification_logs")
}

model FieldTrackingSession {
  id            String               @id @default(cuid())
  companyId     String
  employeeId    String
  startedAt     DateTime             @default(now())
  expiresAt     DateTime
  endedAt       DateTime?
  lastSeenAt    DateTime?
  status        String               @default("ACTIVE")
  consentAt     DateTime
  startDeviceId String?
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee             @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  points        FieldTrackingPoint[]

  @@unique([id, companyId])
  @@index([companyId, status, expiresAt])
  @@index([companyId, employeeId, startedAt])
  @@map("field_tracking_sessions")
}

model FieldTrackingPoint {
  id           String               @id @default(cuid())
  companyId    String
  sessionId    String
  employeeId   String
  latitude     Float
  longitude    Float
  accuracy     Float
  recordedAt   DateTime             @default(now())
  deviceId     String?
  ip           String?
  locationName String?
  session      FieldTrackingSession @relation(fields: [sessionId, companyId], references: [id, companyId], onDelete: Cascade)
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee             @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, sessionId, recordedAt])
  @@index([companyId, employeeId, recordedAt])
  @@map("field_tracking_points")
}

model Payslip {
  id          String           @id @default(cuid())
  companyId   String
  employeeId  String
  periodStart DateTime         @db.Date
  periodEnd   DateTime         @db.Date
  grossPay    Float
  deductions  Float            @default(0)
  netPay      Float
  currency    String           @default("INR")
  issuedAt    DateTime         @default(now())
  breakdown   Json?
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee         @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  runItems    PayrollRunItem[]

  @@unique([companyId, employeeId, periodStart, periodEnd])
  @@unique([id, companyId])
  @@index([companyId, employeeId, periodStart])
  @@map("payslips")
}

model EmployeeDevice {
  id             String          @id @default(cuid())
  companyId      String
  userId         String
  deviceId       String
  deviceName     String?
  platform       String
  osVersion      String?
  appVersion     String?
  lastSeenAt     DateTime        @default(now())
  active         Boolean         @default(true)
  registeredAt   DateTime        @default(now())
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  mobileSessions MobileSession[]

  @@unique([companyId, userId, deviceId])
  @@unique([id, companyId])
  @@index([companyId, userId, active])
  @@map("employee_devices")
}

model PushToken {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  token      String
  platform   String
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([companyId, token])
  @@index([companyId, userId, active])
  @@map("push_tokens")
}

model Shift {
  id                    String        @id @default(cuid())
  companyId             String
  name                  String
  startMinute           Int
  endMinute             Int
  graceMinutes          Int           @default(10)
  breakMinutes          Int           @default(0)
  active                Boolean       @default(true)
  company               Company       @relation(fields: [companyId], references: [id])
  employees             Employee[]
  kind                  String        @default("FIXED")
  splitStartMinute      Int?
  splitEndMinute        Int?
  minimumMinutes        Int?
  halfDayMinutes        Int?
  earlyExitGraceMinutes Int           @default(0)
  overtimeAfterMinutes  Int           @default(0)
  rosterEntries         RosterEntry[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@map("shifts")
}

model Attendance {
  breaks                  AttendanceBreak[]
  workLogs                WorkLog[]
  id                      String                     @id @default(cuid())
  companyId               String
  employeeId              String
  workDate                DateTime                   @db.Date
  checkIn                 DateTime
  checkOut                DateTime?
  workedMinutes           Int                        @default(0)
  lateMinutes             Int                        @default(0)
  overtimeMinutes         Int                        @default(0)
  expectedMinutes         Int                        @default(0)
  breakMinutes            Int                        @default(0)
  shiftName               String?
  source                  String                     @default("Web")
  checkInLocation         Json?
  checkOutLocation        Json?
  correctionReason        String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  company                 Company                    @relation(fields: [companyId], references: [id])
  employee                Employee                   @relation(fields: [employeeId, companyId], references: [id, companyId])
  status                  String                     @default("PRESENT")
  offDay                  Boolean                    @default(false)
  scheduledEnd            DateTime?
  earlyExitMinutes        Int                        @default(0)
  overtimeStatus          String                     @default("NONE")
  approvedOvertimeMinutes Int                        @default(0)
  overtimeReviewedBy      String?
  overtimeReviewedAt      DateTime?
  faceVerificationLogs    FaceVerificationLog[]
  regularizations         AttendanceRegularization[]
  geofenceEvents          GeofenceEvent[]
  punches                 AttendancePunch[]
  compOffRequests         CompOffRequest[]
  devicePunches           DevicePunch[]

  @@unique([companyId, employeeId, workDate])
  @@unique([id, companyId])
  @@index([companyId, workDate])
  @@map("attendance")
}

model Holiday {
  id         String             @id @default(cuid())
  companyId  String
  name       String
  date       DateTime           @db.Date
  company    Company            @relation(fields: [companyId], references: [id])
  optional   Boolean            @default(false)
  selections HolidaySelection[]

  @@unique([companyId, date])
  @@unique([id, companyId])
  @@map("holidays")
}

model LeaveType {
  id              String         @id @default(cuid())
  companyId       String
  name            String
  annualDays      Int
  paid            Boolean        @default(true)
  active          Boolean        @default(true)
  company         Company        @relation(fields: [companyId], references: [id])
  requests        LeaveRequest[]
  accrual         String         @default("ANNUAL")
  carryForwardMax Int            @default(0)
  encashable      Boolean        @default(false)
  encashMax       Int            @default(0)
  halfDayAllowed  Boolean        @default(true)
  approvalLevels  Int            @default(1)
  compOff         Boolean        @default(false)
  ledger          LeaveLedger[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@map("leave_types")
}

model LeaveRequest {
  id          String    @id @default(cuid())
  companyId   String
  employeeId  String
  leaveTypeId String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  days        Float
  reason      String
  status      String    @default("Pending")
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id])
  employee    Employee  @relation(fields: [employeeId, companyId], references: [id, companyId])
  leaveType   LeaveType @relation(fields: [leaveTypeId, companyId], references: [id, companyId])
  halfDay     Boolean   @default(false)
  session     String?
  level       Int       @default(1)
  approvals   Json?

  @@index([companyId, employeeId, startDate])
  @@map("leave_requests")
