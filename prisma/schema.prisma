// Every in/out punch, including repeat punches on one work date and device
// pushes. The day's attendance row is derived from these.
model AttendancePunch {
  id                String      @id @default(cuid())
  companyId         String
  employeeId        String
  attendanceId      String?
  punchedAt         DateTime
  direction         String
  source            String      @default("Web")
  deviceId          String?
  location          Json?
  ip                String?
  clientEventId     String?
  clientPayloadHash String?
  createdAt         DateTime    @default(now())
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee          Employee    @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  attendance        Attendance? @relation(fields: [attendanceId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([companyId, employeeId, clientEventId])
  @@index([companyId, employeeId, punchedAt])
  @@index([attendanceId])
  @@map("attendance_punches")
}

// Date-specific shift assignment. Overrides the employee's default shift;
// weeklyOff marks a rostered day off.
model RosterEntry {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  workDate   DateTime @db.Date
  shiftId    String?
  weeklyOff  Boolean  @default(false)
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  shift      Shift?   @relation(fields: [shiftId, companyId], references: [id, companyId])

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@map("rosters")
}

// Discrete balance movements. Annual and monthly entitlements are derived
// from the leave type; this ledger holds carry-forward, manual adjustments,
// comp-off credits and encashment.
model LeaveLedger {
  id          String    @id @default(cuid())
  companyId   String
  employeeId  String
  leaveTypeId String
  year        Int
  kind        String
  days        Float
  amount      Float?
  expiresAt   DateTime? @db.Date
  note        String?
  refId       String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId, companyId], references: [id, companyId])

  @@index([companyId, employeeId, year])
  @@index([companyId, kind, refId])
  @@map("leave_ledger")
}

model CompOffRequest {
  id           String      @id @default(cuid())
  companyId    String
  employeeId   String
  workDate     DateTime    @db.Date
  days         Float
  reason       String
  status       String      @default("Pending")
  attendanceId String?
  reviewNote   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  expiresAt    DateTime?   @db.Date
  createdAt    DateTime    @default(now())
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee    @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  attendance   Attendance? @relation(fields: [attendanceId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, status])
  @@map("comp_off_requests")
}

model HolidaySelection {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  holidayId  String
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  holiday    Holiday  @relation(fields: [holidayId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([companyId, employeeId, holidayId])
  @@map("holiday_selections")
}

// CURRENT and PERMANENT addresses, one row each per employee.
model EmployeeAddress {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  type       String
  line       String?
  city       String?
  state      String?
  pin        String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([employeeId, type])
  @@index([companyId])
  @@map("employee_addresses")
}

model EmployeeEmergencyContact {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  name         String
  relationship String?
  phone        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("employee_emergency_contacts")
}

// Salary accounts with history: a new primary account deactivates the old
// one. The account number is encrypted; only the last four digits are plain.
model EmployeeBankAccount {
  id               String    @id @default(cuid())
  companyId        String
  employeeId       String
  accountEncrypted String
  accountLast4     String
  ifsc             String?
  bankName         String?
  holderName       String?
  isPrimary        Boolean   @default(true)
  active           Boolean   @default(true)
  createdBy        String
  createdAt        DateTime  @default(now())
  deactivatedAt    DateTime?
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee         Employee  @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, employeeId, active])
  @@map("employee_bank_accounts")
}

// A biometric terminal or vendor server. PUSH devices send punches to this
// server (ZKTeco/eSSL ADMS, Hikvision event push, generic JSON); PULL devices
// are polled over their vendor API (Suprema BioStar 2).
model AttendanceDevice {
  id                  String              @id @default(cuid())
  companyId           String
  name                String
  vendor              String
  model               String?
  serialNumber        String
  mode                String
  locationId          String?
  timezone            String?
  endpoint            String?
  username            String?
  secretEncrypted     String?
  pushTokenHash       String?             @unique
  ipAllowlist         String[]            @default([])
  autoMapByCode       Boolean             @default(true)
  syncIntervalMinutes Int                 @default(15)
  pendingCommand      String?
  active              Boolean             @default(true)
  lastSeenAt          DateTime?
  lastSyncAt          DateTime?
  lastPunchAt         DateTime?
  lastError           String?
  createdBy           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location            AttendanceLocation? @relation(fields: [locationId, companyId], references: [id, companyId], onDelete: NoAction)
  punches             DevicePunch[]
  syncLogs            DeviceSyncLog[]

  @@unique([vendor, serialNumber])
  @@unique([id, companyId])
  @@index([companyId])
  @@map("attendance_devices")
}

// A device enrolment number (PIN / user ID) for one employee, shared by all
// the company's devices.
model DeviceUserMapping {
  id           String   @id @default(cuid())
  companyId    String
  deviceUserId String
  employeeId   String
  createdBy    String
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([companyId, deviceUserId])
  @@index([companyId, employeeId])
  @@map("device_user_mappings")
}

// Raw punches exactly as received, de-duplicated per device, user and time,
// then applied to attendance.
model DevicePunch {
  id            String           @id @default(cuid())
  companyId     String
  deviceId      String
  deviceUserId  String
  punchedAt     DateTime
  directionHint String?
  verifyMode    String?
  raw           Json?
  status        String           @default("PENDING")
  reason        String?
  employeeId    String?
  attendanceId  String?
  attempts      Int              @default(0)
  nextAttemptAt DateTime?
  processedAt   DateTime?
  receivedAt    DateTime         @default(now())
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device        AttendanceDevice @relation(fields: [deviceId, companyId], references: [id, companyId], onDelete: Cascade)
  employee      Employee?        @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: NoAction)
  attendance    Attendance?      @relation(fields: [attendanceId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([deviceId, deviceUserId, punchedAt])
  @@index([companyId, status, nextAttemptAt])
  @@index([companyId, deviceId, punchedAt])
  @@map("device_punches")
}

model DeviceSyncLog {
  id         String           @id @default(cuid())
  companyId  String
  deviceId   String
  trigger    String
  status     String           @default("RUNNING")
  received   Int              @default(0)
  inserted   Int              @default(0)
  processed  Int              @default(0)
  unmapped   Int              @default(0)
  duplicates Int              @default(0)
  failed     Int              @default(0)
  error      String?
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device     AttendanceDevice @relation(fields: [deviceId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, deviceId, startedAt])
  @@map("device_sync_logs")
}

// Effective-dated statutory rules (spec section 24). Rows without a company
// are platform defaults maintained by the provider; a company rule of the
// same type (and state) overrides them. Rates are percentages.
model StatutoryRule {
  id                String    @id @default(cuid())
  companyId         String?
  country           String    @default("IN")
  state             String?
  ruleType          String
  name              String
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  employeeRate      Float?
  employerRate      Float?
  threshold         Float?
  ceiling           Float?
  calculationMethod String
  config            Json      @default("{}")
  active            Boolean   @default(true)
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([ruleType, country, effectiveFrom])
  @@index([companyId, ruleType])
  @@map("statutory_rules")
}

// Salary loans and advances recovered in equal monthly instalments.
model EmployeeLoan {
  id          String          @id @default(cuid())
  companyId   String
  employeeId  String
  kind        String
  principal   Float
  instalment  Float
  balance     Float
  startPeriod String
  status      String          @default("ACTIVE")
  note        String?
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee        @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  repayments  LoanRepayment[]

  @@unique([id, companyId])
  @@index([companyId, employeeId, status])
  @@map("employee_loans")
}

model LoanRepayment {
  id        String       @id @default(cuid())
  companyId String
  loanId    String
  runId     String
  amount    Float
  createdAt DateTime     @default(now())
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  loan      EmployeeLoan @relation(fields: [loanId, companyId], references: [id, companyId], onDelete: Cascade)
  run       PayrollRun   @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([loanId, runId])
  @@map("loan_repayments")
}

// Job offers (spec §26). The candidate accepts or declines through a
// private link; hiring requires the latest offer to be accepted.
model Offer {
  id            String       @id @default(cuid())
  companyId     String
  candidateId   String
  designationId String?
  departmentId  String?
  annualCtc     Float
  joiningDate   DateTime     @db.Date
  expiresOn     DateTime     @db.Date
  terms         String?
  status        String       @default("DRAFT")
  tokenHash     String?      @unique
  sentAt        DateTime?
  respondedAt   DateTime?
  responseNote  String?
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate     Candidate    @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)
  designation   Designation? @relation(fields: [designationId, companyId], references: [id, companyId], onDelete: NoAction)
  department    Department?  @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([id, companyId])
  @@index([companyId, candidateId])
  @@map("offers")
}

// Peer input requested for a review in a cycle (spec §29). Managers and HR
// see individual responses; the employee sees only the average and comments
// without names once the review is completed.
model PeerReview {
  id                 String            @id @default(cuid())
  companyId          String
  reviewId           String
  reviewerEmployeeId String
  status             String            @default("REQUESTED")
  rating             Int?
  comments           String?
  requestedBy        String
  submittedAt        DateTime?
  createdAt          DateTime          @default(now())
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  review             PerformanceReview @relation(fields: [reviewId, companyId], references: [id, companyId], onDelete: Cascade)
  reviewer           Employee          @relation("PeerReviewer", fields: [reviewerEmployeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([reviewId, reviewerEmployeeId])
  @@index([companyId, reviewerEmployeeId, status])
  @@map("peer_reviews")
}

// Learning and development (spec §30).
model Course {
  id                       String            @id @default(cuid())
  companyId                String
  code                     String
  title                    String
  category                 String?
  description              String?
  mode                     String            @default("CLASSROOM")
  durationHours            Float             @default(1)
  provider                 String?
  // Months a certificate stays valid; null when the course is not certified.
  certificationValidMonths Int?
  passScore                Int?
  skills                   String[]
  skillLevel               Int               @default(3)
  mandatory                Boolean           @default(false)
  active                   Boolean           @default(true)
  createdBy                String
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  company                  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions                 TrainingSession[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("courses")
}

model Trainer {
  id           String            @id @default(cuid())
  companyId    String
  name         String
  email        String?
  employeeId   String?
  organization String?
  expertise    String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee?         @relation("TrainerEmployee", fields: [employeeId, companyId], references: [id, companyId], onDelete: NoAction)
  sessions     TrainingSession[]

  @@unique([id, companyId])
  @@unique([employeeId, companyId])
  @@map("trainers")
}

model TrainingSession {
  id             String               @id @default(cuid())
  companyId      String
  courseId       String
  trainerId      String?
  startsAt       DateTime
  endsAt         DateTime
  location       String?
  capacity       Int                  @default(30)
  openEnrollment Boolean              @default(false)
  status         String               @default("SCHEDULED")
  createdBy      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  course         Course               @relation(fields: [courseId, companyId], references: [id, companyId], onDelete: Cascade)
  trainer        Trainer?             @relation(fields: [trainerId, companyId], references: [id, companyId], onDelete: NoAction)
  enrollments    TrainingEnrollment[]

  @@unique([id, companyId])
  @@index([companyId, startsAt])
  @@map("training_sessions")
}

model TrainingEnrollment {
  id            String          @id @default(cuid())
  companyId     String
  sessionId     String
  employeeId    String
  status        String          @default("ENROLLED")
  selfEnrolled  Boolean         @default(false)
  attendedAt    DateTime?
  score         Int?
  passed        Boolean?
  completedAt   DateTime?
  certificateNo String?
  certifiedOn   DateTime?       @db.Date
  expiresOn     DateTime?       @db.Date
  remindedAt    DateTime?
  enrolledBy    String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session       TrainingSession @relation(fields: [sessionId, companyId], references: [id, companyId], onDelete: Cascade)
  employee      Employee        @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([sessionId, employeeId])
  @@index([companyId, employeeId])
  @@index([companyId, expiresOn])
  @@map("training_enrollments")
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  skill      String
  level      Int      @default(3)
  source     String   @default("MANUAL")
  courseId   String?
  verifiedBy String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([employeeId, skill])
  @@index([companyId, skill])
  @@map("employee_skills")
}

// Company assets and their issue/return history (spec §32).
model Asset {
  id            String            @id @default(cuid())
  companyId     String
  assetCode     String
  category      String
  name          String
  brand         String?
  serialNumber  String?
  cost          Float?
  purchaseDate  DateTime?         @db.Date
  warrantyUntil DateTime?         @db.Date
  vendor        String?
  status        String            @default("IN_STOCK")
  condition     String            @default("GOOD")
  location      String?
  notes         String?
  createdBy     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments   AssetAssignment[]

  @@unique([companyId, assetCode])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("assets")
}

model AssetAssignment {
  id               String    @id @default(cuid())
  companyId        String
  assetId          String
  employeeId       String
  issuedOn         DateTime  @db.Date
  expectedReturnOn DateTime? @db.Date
  returnedOn       DateTime? @db.Date
  issueCondition   String
  returnCondition  String?
  issueNotes       String?
  returnNotes      String?
  issuedBy         String
  receivedBy       String?
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset            Asset     @relation(fields: [assetId, companyId], references: [id, companyId], onDelete: Cascade)
  employee         Employee  @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([assetId, issuedOn])
  @@map("asset_assignments")
}

// Billing (spec §46-50, §72-74). Add-ons and coupons are platform-wide and
// configured by the Super Admin; invoices, payments and refunds belong to a
// company. No card data is stored: the payment provider holds it.
model AddOn {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  description     String?
  feature         String?
  priceMonthly    Decimal?            @db.Decimal(12, 2)
  priceAnnual     Decimal             @db.Decimal(12, 2)
  perEmployee     Boolean             @default(false)
  extraStorageMb  Int?
  extraAiRequests Int?
  extraApiCalls   Int?
  active          Boolean             @default(true)
  public          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  subscriptions   SubscriptionAddOn[]

  @@map("add_ons")
}

model SubscriptionAddOn {
  id          String    @id @default(cuid())
  companyId   String
  addOnId     String
  quantity    Int       @default(1)
  startedAt   DateTime  @default(now())
  cancelledAt DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  addOn       AddOn     @relation(fields: [addOnId], references: [id])

  @@unique([companyId, addOnId])
  @@map("subscription_add_ons")
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  percentOff     Decimal?  @db.Decimal(5, 2)
  amountOff      Decimal?  @db.Decimal(12, 2)
  currency       String    @default("INR")
  planCodes      String[]
  validFrom      DateTime?
  validUntil     DateTime?
  maxRedemptions Int?
  redemptions    Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("coupons")
}

// Sequential invoice numbers per financial year.
model InvoiceCounter {
  financialYear String @id
  last          Int    @default(0)

  @@map("invoice_counters")
}

model Invoice {
  id             String    @id @default(cuid())
  companyId      String
  number         String    @unique
  planCode       String
  billingCycle   String
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  currency       String    @default("INR")
  employees      Int       @default(0)
  lines          Json
  subtotal       Decimal   @db.Decimal(12, 2)
  discount       Decimal   @default(0) @db.Decimal(12, 2)
  taxRate        Decimal   @db.Decimal(5, 2)
  cgst           Decimal   @default(0) @db.Decimal(12, 2)
  sgst           Decimal   @default(0) @db.Decimal(12, 2)
  igst           Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  refundedAmount Decimal   @default(0) @db.Decimal(12, 2)
  couponCode     String?
  status         String    @default("ISSUED")
  billingName    String
  billingGstin   String?
  billingAddress String?
  billingState   String?
  placeOfSupply  String?
  dueDate        DateTime  @db.Date
  issuedAt       DateTime  @default(now())
  paidAt         DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments       Payment[]
  refunds        Refund[]

  @@unique([id, companyId])
  @@index([companyId, issuedAt])
  @@map("invoices")
}

model Payment {
  id                String    @id @default(cuid())
  companyId         String
  invoiceId         String
  provider          String
  providerOrderId   String?   @unique
  providerPaymentId String?   @unique
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("INR")
  status            String    @default("CREATED")
  method            String?
  reference         String?
  failureReason     String?
  capturedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice           Invoice   @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Cascade)
  refunds           Refund[]

  @@unique([id, companyId])
  @@index([companyId, createdAt])
  @@map("payments")
}

model Refund {
  id               String   @id @default(cuid())
  companyId        String
  invoiceId        String
  paymentId        String
  amount           Decimal  @db.Decimal(12, 2)
  reason           String
  status           String   @default("PENDING")
  providerRefundId String?  @unique
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice          Invoice  @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Cascade)
  payment          Payment  @relation(fields: [paymentId, companyId], references: [id, companyId], onDelete: Cascade)

  @@map("refunds")
}

// Self-service signups waiting for email verification (spec §75-76).
model SignupRequest {
  id           String    @id @default(cuid())
  companyName  String
  companyCode  String
  adminName    String
  email        String
  phone        String?
  passwordHash String
  timezone     String    @default("Asia/Kolkata")
  tokenHash    String    @unique
  expiresAt    DateTime
  verifiedAt   DateTime?
  companyId    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@map("signup_requests")
}

// Contact form enquiries from the marketing site.
model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  employees Int?
  message   String
  ip        String?
  createdAt DateTime @default(now())
  notificationState Json @default("{}")
  nextNotificationAt DateTime?
  notificationLockedUntil DateTime?

  @@index([nextNotificationAt])

  @@map("contact_leads")
}

// Data retention (spec §80). Nothing is removed without an enabled policy
// above the category minimum; a legal hold stops every run.
model RetentionPolicy {
  id         String   @id @default(cuid())
  companyId  String
  category   String
  retainDays Int
  enabled    Boolean  @default(false)
  updatedBy  String
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, category])
  @@map("retention_policies")
}

model RetentionRun {
  id        String   @id @default(cuid())
  companyId String
  category  String
  cutoff    DateTime @db.Date
  dryRun    Boolean
  affected  Int
  runBy     String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("retention_runs")
}

model WorkAgency {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  contactName String?
  email       String?
  phone       String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contracts   WorkerContract[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@map("work_agencies")
}

model WorkerContract {
  id         String     @id @default(cuid())
  companyId  String
  employeeId String
  agencyId   String
  startsOn   DateTime   @db.Date
  endsOn     DateTime   @db.Date
  status     String     @default("ACTIVE")
  reference  String?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  agency     WorkAgency @relation(fields: [agencyId, companyId], references: [id, companyId], onDelete: NoAction)

  @@index([companyId, employeeId, startsOn])
  @@map("worker_contracts")
}

model WorkJob {
  id          String           @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?
  branchId    String?
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch?          @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: NoAction)
  assignments WorkAssignment[]
  logs        WorkLog[]

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@map("work_jobs")
}

model WorkAssignment {
  id         String   @id @default(cuid())
  companyId  String
  jobId      String
  employeeId String
  title      String
  startsAt   DateTime
  endsAt     DateTime
  status     String   @default("PLANNED")
  progress   Int      @default(0)
  note       String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job        WorkJob  @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: NoAction)
  employee   Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, employeeId, startsAt])
  @@map("work_assignments")
}

model WorkLog {
  id           String     @id @default(cuid())
  companyId    String
  jobId        String
  employeeId   String
  attendanceId String
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  note         String?
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job          WorkJob    @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: NoAction)
  employee     Employee   @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  attendance   Attendance @relation(fields: [attendanceId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, employeeId, startedAt])
  @@map("work_logs")
}

model AttendanceBreak {
  id           String     @id @default(cuid())
  companyId    String
  employeeId   String
  attendanceId String
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  attendance   Attendance @relation(fields: [attendanceId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, employeeId, startedAt])
  @@map("attendance_breaks")
}
